{
  "manifest_version": 3,
  "name": "SyncFlow + Scrapling Universal Cross-Lister",
  "version": "2.6.1",
  "description": "Review imported products in a local catalog and prepare marketplace listing drafts.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.com/*",
        "https://*.ebay.es/*",
        "https://*.ebay.fr/*",
        "https://*.vinted.fr/*",
        "https://*.vinted.es/*",
        "https://*.etsy.com/*",
        "https://*.depop.com/*",
        "https://*.wallapop.com/*",
        "https://*.amazon.com/*"
      ],
      "js": [
        "review.js",
        "scrapling_engine.js",
        "universal_scraper.js",
        "universal_poster.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SyncFlow + Scrapling Cross-Lister"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
